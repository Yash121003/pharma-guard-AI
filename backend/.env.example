# =====================================================================
# AI Complaint Management System -- Backend Environment Configuration
# Copy this file to .env and fill in real values before running.
# =====================================================================

# --- Database (required) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/complaint_mgmt

# --- JWT Auth (required) ---
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Groq / AI (required for real AI responses -- see AI_MOCK_MODE below) ---
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_DEFAULT=gemma2-9b-it
GROQ_MODEL_ADVANCED=llama-3.3-70b-versatile

# AI_MOCK_MODE controls whether AI endpoints call the real Groq API or
# return deterministic mock responses. This is independent of whether
# GROQ_API_KEY is set.
#
#   AI_MOCK_MODE=true   -> All AI features (extract, chat, summarize,
#                          root cause, CAPA, risk, duplicate check,
#                          completeness) return realistic mock output.
#                          No network calls to Groq are made. Useful for
#                          frontend development, demos, and offline/CI
#                          environments where Groq isn't reachable.
#   AI_MOCK_MODE=false  -> All AI features call the real Groq API using
#                          GROQ_API_KEY. This requires a valid key and
#                          network access to api.groq.com.
#
# See README.md "AI Modes" section for full details.
AI_MOCK_MODE=true

# --- App ---
APP_NAME=AI Complaint Management System
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
