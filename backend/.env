# SQLite for local development (no PostgreSQL needed)
DATABASE_URL=sqlite:///./complaint_mgmt.db

# JWT Auth
SECRET_KEY=local-dev-secret-key-do-not-use-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Mock Mode (no Groq key needed)
AI_MOCK_MODE=true

# App
APP_NAME=AI Complaint Management System
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

